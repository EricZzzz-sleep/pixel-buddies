{
  "name": "pixel-buddies-tools",
  "private": true,
  "description": "像素搭子：离线工具链（类型检查、单元测试、像素图与音效生成）。不参与 Cocos 构建。",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check:wechat-api": "tsc -p tsconfig.wxcompat.json",
    "verify": "npm run typecheck && npm run check:wechat-api && npm test",
    "art": "tsx render-art.ts",
    "audio": "tsx gen-audio.ts"
  },
  "devDependencies": {
    "@cocos/creator-types": "^3.8.8",
    "@douyin-microapp/typings": "^1.3.1",
    "minigame-api-typings": "^3.8.22",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}