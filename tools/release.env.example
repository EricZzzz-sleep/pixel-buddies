# 复制为 tools/release.env（已在 .gitignore 中，不会提交）后填写。build-mini.sh 会自动读取。
#
# 微信公众平台 → 开发管理 → 开发设置 → AppID
WX_APPID=
# 抖音开放平台 → 小游戏 → 开发设置 → AppID
TT_APPID=
# 远程资源（主题曲）根地址：必须是已 ICP 备案的 https 域名，例如腾讯云 COS 绑定的自定义域名。
# 构建后把 build/<平台>/remote/ 上传到 <MINI_REMOTE_BASE>/mini/<平台>/remote/，
# 并在平台后台把这个域名加入 downloadFile 合法域名。
MINI_REMOTE_BASE=
